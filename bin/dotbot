#!/usr/bin/env sh

# This is a valid shell script and also a valid Python script. When this file
# is executed as a shell script, it finds a Python 3.14+ binary and executes
# this file as a Python script, passing along all of the command line
# arguments. If there is no Python 3.14+ on the PATH, it uses uv to find or
# download one, and if uv is not installed, it first downloads a pinned version
# of uv (verifying its checksum) into the cache directory. When this file is
# executed as a Python script, it loads and runs Dotbot. This is useful because
# we don't know the name of the python binary.

''':' # begin python string; this line is interpreted by the shell as `:`
for python in python3 python; do
  if command -v "$python" >/dev/null 2>&1 &&
    "$python" -c 'import sys; sys.exit(sys.version_info < (3, 14))' >/dev/null 2>&1; then
    exec "$python" "$0" "$@"
  fi
done

uv_version=0.12.23
uv=$(command -v uv 2>/dev/null)
if [ -z "$uv" ]; then
  cache_directory="${XDG_CACHE_HOME:-$HOME/.cache}/dotbot"
  uv_directory="$cache_directory/uv-$uv_version"
  uv="$uv_directory/uv"
  if [ ! -x "$uv" ]; then
    case "$(uname -s)-$(uname -m)" in
      Darwin-arm64) target=aarch64-apple-darwin sha256=50487ae565ccd96e499056b4674d438f4c53170202617b4c759defe0c6a1b544 ;;
      Darwin-x86_64) target=x86_64-apple-darwin sha256=960da44cb4b73685206ddd250b19e0a117fa41095710c1038f081f5cb613efb4 ;;
      Linux-aarch64 | Linux-arm64) target=aarch64-unknown-linux-musl sha256=b536543cc4d50661986b165c76ee8aa9056e4fa332edcd153ff2e98760f9359b ;;
      Linux-x86_64) target=x86_64-unknown-linux-musl sha256=1cff8783850e794470aadb73f54b749542a511fc57b0ce6468b64bd3852e0ade ;;
      *)
        >&2 echo "error: cannot find Python 3.14+ or uv; install one of them"
        exit 1
        ;;
    esac
    url="https://github.com/astral-sh/uv/releases/download/$uv_version/uv-$target.tar.gz"
    >&2 echo "Cannot find Python 3.14+ or uv; downloading uv $uv_version to $uv_directory"
    mkdir -p "$cache_directory" && tmp=$(mktemp -d "$cache_directory/tmp.XXXXXX") || exit 1
    if command -v curl >/dev/null 2>&1; then
      curl -fsSL -o "$tmp/uv.tar.gz" "$url"
    else
      wget -q -O "$tmp/uv.tar.gz" "$url"
    fi || {
      rm -rf "$tmp"
      >&2 echo "error: cannot download $url"
      exit 1
    }
    if command -v sha256sum >/dev/null 2>&1; then
      actual=$(sha256sum "$tmp/uv.tar.gz")
    else
      actual=$(shasum -a 256 "$tmp/uv.tar.gz")
    fi
    if [ "${actual%% *}" != "$sha256" ]; then
      rm -rf "$tmp"
      >&2 echo "error: checksum mismatch for $url"
      exit 1
    fi
    rm -rf "$uv_directory"
    tar -xzf "$tmp/uv.tar.gz" -C "$tmp" && mv "$tmp/uv-$target" "$uv_directory"
    rm -rf "$tmp"
  fi
fi

python=$("$uv" python find --no-project '>=3.14' 2>/dev/null) ||
  { "$uv" python install --no-bin 3.14 >&2 && python=$("$uv" python find --no-project '>=3.14'); } ||
  {
    >&2 echo "error: cannot find or install Python 3.14+"
    exit 1
  }
exec "$python" "$0" "$@"
'''

# python code

import os
import sys

# this file is syntactically valid Python 2; bail out if the interpreter is too old
if sys.version_info < (3, 14):
    sys.stderr.write('error: this version of Dotbot requires Python 3.14+\n')
    sys.exit(1)

project_root_directory = os.path.dirname(
    os.path.dirname(os.path.realpath(__file__)))

def inject(lib_path):
    path = os.path.join(project_root_directory, 'lib', lib_path)
    sys.path.insert(0, path)

inject('pyyaml/lib')

if os.path.exists(os.path.join(project_root_directory, 'src', 'dotbot')):
    src_directory = os.path.join(project_root_directory, 'src')
    if src_directory not in sys.path:
        sys.path.insert(0, src_directory)
        # let subprocesses import dotbot, but keep the PYTHONPATH of the user
        python_path = os.environ.get('PYTHONPATH')
        os.environ['PYTHONPATH'] = src_directory + os.pathsep + python_path if python_path else src_directory

import dotbot

dotbot.cli.main()
